{
  "manifest_version": 3,
  "name": "betterLD",
  "version": "0.1.65",
  "description": "Material 3 原生主题列表、真实网页预览与树状回复。",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "host_permissions": [
    "https://linux.do/*",
    "https://www.linux.do/*",
    "https://api.github.com/*"
  ],
  "background": {
    "scripts": [
      "betterld.config.js",
      "src/webdav.js",
      "src/external-search.js",
      "src/background.js"
    ],
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://linux.do/*",
        "https://www.linux.do/*"
      ],
      "js": [
        "betterld.config.js",
        "src/settings.js",
        "src/markdown.js",
        "src/external-search.js",
        "src/topic-library.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css",
        "src/topic-library.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "betterLD 设置",
    "default_popup": "src/options.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "betterld.config.js",
        "src/page-refresh.js",
        "src/options.html",
        "src/options.css",
        "src/options.js",
        "src/settings.js"
      ],
      "matches": [
        "https://linux.do/*",
        "https://www.linux.do/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "betterld@linux.do",
      "strict_min_version": "109.0"
    }
  }
}
