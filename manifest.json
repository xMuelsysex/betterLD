{
  "manifest_version": 3,
  "name": "betterLD",
  "version": "1.0.4",
  "description": "Material 3 原生主题列表、真实网页预览与树状回复。",
  "permissions": [
    "storage",
    "contextMenus",
    "downloads"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "host_permissions": [
    "https://linux.do/*",
    "https://www.linux.do/*",
    "https://cdn.ldstatic.com/*",
    "https://cdn3.ldstatic.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "scripts": [
      "betterld.config.js",
      "src/offline-assets.js",
      "src/webdav.js",
      "src/external-search.js",
      "src/library-entry.js",
      "src/library-store.js",
      "src/user-marks.js",
      "src/sticker-store.js",
      "src/sticker-db.js",
      "src/background.js"
    ],
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://linux.do/*",
        "https://www.linux.do/*"
      ],
      "js": [
        "betterld.config.js",
        "src/settings.js",
        "src/appearance.js",
        "src/startup.js"
      ],
      "css": [
        "src/content.css",
        "src/topic-library.css",
        "src/topic-export.css",
        "src/sticker-library.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://linux.do/*",
        "https://www.linux.do/*"
      ],
      "js": [
        "src/external-search.js",
        "src/library-entry.js",
        "src/library-store.js",
        "src/user-marks.js",
        "src/sticker-store.js",
        "src/sticker-zip.js",
        "src/sticker-library.js",
        "src/offline-assets.js",
        "src/share-image.js",
        "src/topic-library.js",
        "src/topic-export.js",
        "src/media.js",
        "src/content.js"
      ],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "betterLD 设置",
    "default_popup": "src/options.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "betterld.config.js",
        "src/page-refresh.js",
        "src/sticker-composer.js",
        "src/options.html",
        "src/options.css",
        "src/options.js",
        "src/settings.js",
        "src/library-entry.js",
        "src/library-store.js",
        "src/user-marks.js"
      ],
      "matches": [
        "https://linux.do/*",
        "https://www.linux.do/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "betterld@linux.do",
      "strict_min_version": "109.0"
    }
  }
}
